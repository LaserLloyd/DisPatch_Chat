# =============================================================================
#  DisPatch Chat — environment configuration
# =============================================================================
#  Copy to `.env` next to docker-compose.yml and edit. Everything here has a
#  working default; an EMPTY .env starts a usable server.
#
#      cp .env.example .env
#
#  Notes on syntax:
#    * docker compose reads this file itself. There is NO shell here — no
#      `$(cmd)`, no `~`. Write absolute paths.
#    * Do not quote values unless the quotes are part of the value. Compose
#      keeps quotes literally in some versions; `TZ="Asia/Tokyo"` has bitten
#      people. Write `TZ=Asia/Tokyo`.
#    * Boolean-ish vars in this app are "off" only for the exact strings
#      `0`, `false`, `False`, or empty. `no`, `off`, `FALSE` all read as ON.
#      This is a real footgun — write `0` when you mean off.
#
#  SECURITY: the PIN, the recovery code and the inbound API token are NOT set
#  here. They live in `<data>/security.yaml`, generated on first run and
#  managed from the app's Security modal. Never put them in .env — compose
#  files get committed to git, and `docker inspect` shows env to any user in
#  the `docker` group.
#
#  VARIABLE NAMES: every app setting answers to two spellings — `DISPATCH_FOO`
#  (documented, and the one that wins) and the legacy `LOCAL_CHAT_FOO`, kept so
#  that installs and service units written before the rename keep working. This
#  file uses the DISPATCH_ names throughout. If you inherited a .env full of
#  LOCAL_CHAT_ names it still works; just do not set both, because the
#  DISPATCH_ one silently wins and you will spend an evening on it.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. Identity & storage  (the two you actually have to think about)
# -----------------------------------------------------------------------------

# Host port published on your machine. The container always listens on 8765
# internally; change this side only.
HOST_PORT=8765

# Which host address that port is published on. THIS is what decides who can
# reach the app, and the default is deliberately wide:
#   0.0.0.0    (default) reachable from your LAN — what most people want
#   127.0.0.1            this host only. Use it when a reverse proxy fronts the
#                        app, or before you have set a PIN.
# The container itself always binds 0.0.0.0 inside its own network namespace;
# BIND_ADDR is the only lever that matters here. (A bare `uvicorn app.main:app`
# with no container is the opposite: it binds 127.0.0.1 unless told otherwise.)
BIND_ADDR=0.0.0.0

# Where the data volume lives. NOTE: `DATA_PATH` is a COMPOSE variable, not an
# app setting — it is the host side of the /data bind mount. The app's own
# setting is DISPATCH_DATA_DIR, and the image already sets it to /data; do not
# set DISPATCH_DATA_DIR here unless you also change the mount.
#   - Leave DATA_PATH unset to use a Docker *named volume* (recommended on
#     Windows and macOS, and the safest default on Linux).
#   - Set it to an absolute host path to use a *bind mount* (recommended on a
#     Pi with an SSD, so the DB lands on the SSD and not the SD card).
#  Bind mounts on Linux hit the UID/GID problem — read
#  docs/deploy-docker.md § "Volume permissions" BEFORE setting this.
#DATA_PATH=/srv/dispatch/data

# UID/GID the app runs as inside the container. These MUST match the owner of
# DATA_PATH when you use a bind mount on Linux. Find yours with `id -u; id -g`.
# Ignored (harmless) on Docker Desktop for Windows/macOS.
PUID=1000
PGID=1000

# PUID/PGID above only take effect if the container is allowed to START as
# root, do the chown, and then drop privileges. That is what RUN_AS=0:0 does.
#
#   unset (default)  container runs as 1000:1000 from its very first
#                    instruction. Most secure. Correct if your host user is
#                    UID 1000 (the default on Ubuntu, Debian, Raspberry Pi OS)
#                    or if you use a named volume.
#   RUN_AS=0:0       starts as root, chowns /data to PUID:PGID, then drops to
#                    it. Use this when your host UID is not 1000 and you need
#                    a bind mount. Also uncomment the cap_add line in
#                    docker-compose.yml, or the chown will fail.
#RUN_AS=0:0

# Container timezone. Affects log timestamps, the daily thread rollover, and
# the nightly reaction-pool top-up hour. `UTC` if you don't care.
TZ=UTC


# -----------------------------------------------------------------------------
#  2. Networking
# -----------------------------------------------------------------------------

# Bind address INSIDE the container. Leave at 0.0.0.0 — Docker's port mapping
# is what controls exposure. Setting 127.0.0.1 here makes the container
# unreachable from outside itself, which is almost never what you want.
DISPATCH_HOST=0.0.0.0
DISPATCH_PORT=8765

# Public hostname, used ONLY by the optional Caddy reverse proxy to decide
# whether to fetch a real certificate.
#   - a real DNS name you own       -> Caddy gets a Let's Encrypt cert
#   - `localhost` or an IP          -> Caddy issues a local self-signed cert
#     (browsers will warn; that is expected)
#  Leave commented out to run without the proxy at all.
#SITE_ADDRESS=chat.example.com
#ACME_EMAIL=you@example.com

# The address people actually type to reach this install, including the scheme.
# The app cannot see through a reverse proxy, so this is how it learns that the
# thing in front of it terminates TLS. The host dashboard's security check reads
# it: without a declaration it has to assume plain HTTP and reports the install
# as unencrypted, which is either a real finding or a permanently wrong one.
#DISPATCH_PUBLIC_URL=https://chat.example.com

# The same declaration without a URL, for a proxy on a name you would rather not
# write down here. Any value other than 0/false/no means "TLS terminates in
# front of me". Setting DISPATCH_PUBLIC_URL to an https:// address already
# implies this; you do not need both.
#DISPATCH_BEHIND_TLS=1


# -----------------------------------------------------------------------------
#  3. Agent backend  (OPTIONAL — the app runs fine with no agents at all)
# -----------------------------------------------------------------------------
#  DisPatch talks to agents by SPAWNING A CLI BINARY as a subprocess and by
#  READING that agent runtime's session transcripts off disk. Neither of those
#  crosses a container boundary on its own. Read
#  docs/deploy-docker.md § "Agents in a container" before touching this — the
#  short version is: with no agent backend configured you get a fully working
#  multi-device chat + file server, just no bot replies.
#
#  YOU PROBABLY DO NOT NEED ANY OF THIS. If all you want is something to talk
#  to, use "Connect an AI" (the 🔌 button in the app, unlocked): it points a bot
#  straight at an LLM provider's HTTP API — LM Studio, Ollama, OpenAI,
#  Anthropic, or anything OpenAI-compatible — which works in a container with
#  nothing mounted and no CLI installed. There are no environment variables for
#  it; the settings live in config.yaml in the data directory. The section
#  below is only for a full AGENT runtime that can use tools.
#  See docs/llm-providers.md.

# Path to the agent CLI *inside the container*. The default (`openclaw`, found
# on PATH) will not exist in the stock image, which is fine and expected: the
# app logs one warning at boot and every agent turn returns a clean error.
# To wire a real backend you must either bake the CLI into a derived image or
# bind-mount it in — see the doc.
#OPENCLAW_BIN=/opt/agent/bin/openclaw

# Where the agent runtime keeps `agents/<id>/sessions/*.jsonl`. The app tails
# these to stream partial replies and to mirror gateway-side conversations.
# In a container this is only meaningful if you bind-mount the host directory.
#   read-only is enough:  - ${AGENT_HOME}:/home/app/.openclaw:ro
#
# The app itself NEVER reads AGENT_HOME. It is only a convenience name for the
# host side of a volume line you add to docker-compose.yml yourself — setting it
# here and nothing else does nothing at all.
#AGENT_HOME=/home/youruser/.openclaw

# Seconds a single agent turn may take before the app kills it.
DISPATCH_AGENT_TIMEOUT=900

# How many agent subprocesses may run at once. Protects a local-model box from
# being asked to run five 70B turns in parallel. On a Pi with a remote agent
# backend you can raise this; with a LOCAL model on a Pi, set it to 1.
DISPATCH_MAX_CONCURRENCY=3

# Gateway chat mirror: continuously tail the agent runtime's own conversations
# into DisPatch threads. Requires AGENT_HOME to be mounted. With no agent
# backend this loop finds nothing and idles, but turning it OFF saves a
# pointless filesystem scan every few seconds — worth doing on a Pi.
DISPATCH_MIRROR=0
DISPATCH_MIRROR_POLL=4
DISPATCH_MIRROR_IDLE_MAX=60
# Sessions whose transcript is already older than this many hours when first
# seen are tailed from EOF — new activity mirrors, old history is not imported.
DISPATCH_MIRROR_HORIZON_H=72
# Which session kinds to mirror. `other` adds scripted/watchdog sessions.
DISPATCH_MIRROR_KINDS=webchat,main


# -----------------------------------------------------------------------------
#  4. Features that DO NOT WORK IN A CONTAINER  (off by default in the image)
# -----------------------------------------------------------------------------
#  Both of these drive the *host operating system*. They are host-install
#  features. The image sets them to 0 and the routes 404. Turning them on
#  inside a container gets you a broken panel, not a working one.

# Coding terminal: spawns an interactive CLI on a server-side PTY, running
# as the app user with full filesystem access, exposed over a WebSocket. In a
# container it would spawn a shell inside the container — which is what
# `docker exec` is for, with better isolation. Leave at 0.
DISPATCH_TERMINAL=0

# The coding CLI the terminal spawns: a bare name resolved on PATH, or an
# absolute path. No default — unset means the terminal reports "not configured"
# rather than guessing at a binary. Only read when DISPATCH_TERMINAL=1.
DISPATCH_TERMINAL_BIN=

# Optional. Extra PATH entries for the spawned CLI, colon-separated, appended in
# order — for a CLI whose sibling tools live outside the service's PATH.
DISPATCH_TERMINAL_PATH=

# Optional. Colon-separated TOML paths the model picker reads, for a CLI that
# keeps its providers in a config file. Unset = no model picker.
DISPATCH_TERMINAL_CONFIG=


# -----------------------------------------------------------------------------
#  5. Storage limits  (TUNE THESE ON A PI — the defaults assume a desktop)
# -----------------------------------------------------------------------------

# Server-wide ceiling across ALL stored blobs (chat media + File Server), in
# BYTES. 0 disables the cap. Default 20 GiB.
#   Pi with a 32 GB SD card -> 5 GiB is a sane cap:
#DISPATCH_FILES_TOTAL_MAX=5368709120
DISPATCH_FILES_TOTAL_MAX=21474836480

# Per-client, per-day budgets for *Safe Mode* (locked, no-PIN) clients. Full
# sessions are unaffected. All three are in-memory and reset on restart.
#
# These are abuse caps, not comfort settings. A Safe-Mode peer on your LAN or
# tailnet can trigger agent turns, and an agent turn can be a BILLED model
# call — without a rate cap someone on your network can run up your API bill
# and fill the database with threads. Raise them only if a household member
# genuinely hits the ceiling.
DISPATCH_DECOY_UPLOAD_QUOTA=209715200    # bytes/day/client
DISPATCH_DECOY_TURN_QUOTA=200            # agent turns/day/client
DISPATCH_DECOY_THREAD_QUOTA=50           # new threads/day/client

# Where multipart uploads spool before being written to the blob store.
# Uploads are streamed but FastAPI's UploadFile spools to TMPDIR first, and
# the single-file limit is 4 GiB. Keep this on real disk on the data volume:
# if you mount /tmp as tmpfs (some hardening guides tell you to), a large
# upload becomes a RAM allocation and the OOM killer takes the app. Pointing
# it at /data/tmp also means the spool and the destination are on the same
# filesystem, so the final move is a rename and not a copy.
TMPDIR=/data/tmp


# -----------------------------------------------------------------------------
#  6. Backups  (see docs/deploy-raspberry-pi.md § Backups — you want these)
# -----------------------------------------------------------------------------

# Seconds between online SQLite snapshots into <data>/backups/. 0 disables the
# loop (manual export still works). 21600 = 6 hours.
DISPATCH_BACKUP_INTERVAL=21600

# How many rotated snapshots to keep. Each is roughly the size of chats.db.
DISPATCH_BACKUP_KEEP=12

# NOTE: these snapshots live INSIDE the same volume as the database. That
# protects you from corruption and fat-fingering, NOT from losing the disk.
# You still need an off-box copy. The Pi doc has a 6-line cron for it.


# -----------------------------------------------------------------------------
#  7. Cosmetic / rarely changed
# -----------------------------------------------------------------------------

# Show a short canned greeting in a brand-new thread (no model call).
DISPATCH_GREETING=0

# Write the app log to a file as well as to stdout, and tell the host
# dashboard's log viewer where to look. Unset (the default) means logs go to
# stdout only — which is correct under Docker and systemd, and means the
# dashboard's log panel says "no file, use `docker logs`" rather than being
# broken. Inside a container this must be a path on the data volume, or it
# vanishes with the container.
#DISPATCH_LOG_FILE=/data/logs/dispatch.log

# Compose-level resource limits. Raised into docker-compose.yml so a Pi user
# can cap the app without editing YAML. See docs/deploy-raspberry-pi.md for
# how these were picked.
MEM_LIMIT=1g
MEM_RESERVATION=256m
CPU_LIMIT=2.0


# -----------------------------------------------------------------------------
#  8. Image selection
# -----------------------------------------------------------------------------
# Left unset ON PURPOSE. With no IMAGE set, `docker compose up -d` BUILDS the
# image from this checkout and tags it `dispatch-chat:local` — which works
# offline, on any architecture, and needs no registry account.
#
# To pull a published image instead, uncomment the line below — repointing it
# at your own fork if you are running one:
#
#     sed -i 's|LaserLloyd/dispatch-chat|myuser/dispatch-chat|g' .env
#
#  (Repo-wide, including this file:
#     grep -rl 'LaserLloyd/dispatch-chat' --exclude-dir=.git . \
#       | xargs sed -i 's|LaserLloyd/dispatch-chat|myuser/dispatch-chat|g')
#
# Pin a version in production. `latest` is convenient and will eventually
# restart you onto a release you did not read the notes for.
#IMAGE=ghcr.io/LaserLloyd/dispatch-chat:latest


# -----------------------------------------------------------------------------
#  Things you might expect here but that live elsewhere
# -----------------------------------------------------------------------------
#  PIN / recovery code / inbound API token .. <data>/security.yaml  (app UI)
#  Bot roster, names, avatars, safe flags ... <data>/config.yaml
#  Reaction pool sizing + nightly hour ...... <data>/reaction-pool-<bot>.yaml (one per reactions bot)
#  Reaction prompt bank ..................... <data>/reaction-prompts-<bot>.yaml
#  Remembered-device tokens (hashes only) ... <data>/trusted-devices.yaml
#
#  Deliberately NOT exposed as env in the container image, because they point
#  at host installs that do not exist inside it:
#    DISPATCH_IMAGE_CLI, DISPATCH_IMAGE_CLI_TIMEOUT, DISPATCH_GPU_CLI,
#    DISPATCH_MINT_MIN_FREE_GB, DISPATCH_POOL_FREE_VRAM (default 0: never
#    unload models on the image host), DISPATCH_GLYPH_FONTS / DISPATCH_TEXT_FONTS,
#    DISPATCH_DSH_BIN
#  They still work if you set them; see docs/configuration.md § "Optional
#  image-host integration".


# -----------------------------------------------------------------------------
#  9. Everything else the code reads  (all commented — all have working defaults)
# -----------------------------------------------------------------------------
#  Listed so this file and the set of variables the app actually reads are the
#  same set. Full descriptions in docs/configuration.md.

# PBKDF2 rounds for the PIN hash. Lower it only on hardware that genuinely
# cannot afford the default, and know what you are trading away.
#DISPATCH_PBKDF2_ITERATIONS=200000

# Native agent-gateway WebSocket transport. Unset/0 = off (transcript tailing
# only), `shadow` = connect and log what it WOULD deliver, 1 = live.
#DISPATCH_GATEWAY_WS=0
#OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
#OPENCLAW_GATEWAY_TOKEN=
#  ^ read under those exact names (no DISPATCH_ prefix) — they are the agent
#    runtime's own variables. There is NO loopback exemption on the gateway
#    side: without a token the transport does not connect.

# Agent image jobs: a bot asks for a generated picture (POST /api/image-jobs),
# a placeholder message lands in the thread at once, and DisPatch rewrites that
# message into the picture — or into a visible failure line — when the render
# arrives. There is NO default endpoint on purpose, and `auto` therefore means
# "on iff DISPATCH_CLAWFORGE_URL is set". The bot also needs `image_jobs: true`
# in config.yaml; both switches have to agree.
#DISPATCH_CLAWFORGE_URL=http://192.0.2.5:8700/mcp
#DISPATCH_CLAWFORGE_FILES_URL=
#DISPATCH_IMAGE_JOBS=auto

# Coding-agent harness pane (dsh). `auto` = on only if a `dsh` binary is found
# at boot; 1 forces it on; 0 disables and 404s the routes. Host-install
# feature — there is no dsh and no systemd in the container image.
#DISPATCH_HARNESS=0
#DISPATCH_HARNESS_UNIT=dsh-web.service
#DISPATCH_HARNESS_PORT=3080
#DSH_HOME=/home/youruser/.dsh
