# ---------------------------------------------------------------------------
# DisPatch Chat — .gitignore
#
# This file is a SECOND line of defence, not the first. The first is
# scripts/sync_from_live.py, which copies an explicit allowlist of paths out of
# a running install, and scripts/scrub_check.py, which fails the build if
# anything that looks like private data reaches the tree. If you find yourself
# adding a rule here to hide user data, add it to the scrubber too.
# ---------------------------------------------------------------------------

# --- Runtime data. NEVER commit any of this. ---
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backups/
media/
files/
logs/
reactions/
# Drive mode: voice profiles are recordings of a real person; models are big.
voices/
speech-models/
*.npz
avatars/*
!avatars/.gitkeep
!avatars/README.md
frontend/static/avatars/*
!frontend/static/avatars/.gitkeep
!frontend/static/avatars/defaults/

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
security.yaml
config.yaml
trusted-devices.yaml
gateway-mirror.json
RECOVERY-CODE.txt
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# --- Node (only used for optional tooling; the app itself has no build step) ---
node_modules/
npm-debug.log*

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Local scratch ---
*.bak
*.bak-*
*.orig
*.rej
*.part
/tmp/
scratch/

# Screenshots taken by the e2e scripts. A capture of a running instance shows
# real conversation — bot names, avatars, message previews, mailbox addresses —
# and NONE of it is visible to scripts/scrub_check.py, which reads text and
# cannot see inside a PNG. So the e2e tooling writes here by default and
# docs/screenshots/ only ever receives a picture somebody chose, and looked at,
# deliberately. (tests/e2e/mobile_layout.py once wrote 20 files straight into
# docs/screenshots/; they were one `git add -A` from a public repo.)
.screenshots-local/

# Per-fork scrubber identifiers — never publish the list itself.
scripts/scrub-rules.local.txt

# Single-instance flock, created at runtime in the data dir.
.instance.lock

# Console output from local tooling run with the repo as cwd. Such logs
# carry absolute home paths, so they trip the privacy scan -- and without
# this rule one `git add -A` would publish one.
*.log

# Agent scaffolding: parallel worktrees and session state, never part of the app.
.claude/

# Local-only working state: agent memory, staging copies, assistant config and
# private e2e driver scripts. None of it belongs in the public tree.
memory/
.staging-*/
.claude/
CLAUDE.md
CLAUDE.local.md
scripts/e2e-*.sh
