{
  "$defs": {
    "SettingField": {
      "additionalProperties": false,
      "description": "One setting a plugin contributes to its Settings section (rendered from this).",
      "properties": {
        "advanced": {
          "default": false,
          "title": "Advanced",
          "type": "boolean"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "description": {
          "default": "",
          "maxLength": 400,
          "title": "Description",
          "type": "string"
        },
        "env": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Env"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "choice",
            "secret",
            "url",
            "path"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "type",
        "label"
      ],
      "title": "SettingField",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A model/service endpoint DisPatch talks to (an LLM provider, an image rig, a\nspeech server). The Settings > Connections section is generated from these.",
  "properties": {
    "api_key_env": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Key Env"
    },
    "auth": {
      "default": "none",
      "enum": [
        "none",
        "api_key",
        "bearer",
        "basic"
      ],
      "title": "Auth",
      "type": "string"
    },
    "base_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Url"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "description": {
      "default": "",
      "maxLength": 400,
      "title": "Description",
      "type": "string"
    },
    "discover": {
      "items": {
        "type": "string"
      },
      "title": "Discover",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "llm",
        "image",
        "speech",
        "agent",
        "search",
        "other"
      ],
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "maxLength": 80,
      "title": "Name",
      "type": "string"
    },
    "protocol": {
      "default": "openai",
      "enum": [
        "openai",
        "anthropic",
        "lmstudio",
        "ollama",
        "mcp",
        "http",
        "custom"
      ],
      "title": "Protocol",
      "type": "string"
    },
    "requires_permission": {
      "default": "manage_connections",
      "title": "Requires Permission",
      "type": "string"
    },
    "schema": {
      "const": 1,
      "default": 1,
      "title": "Schema",
      "type": "integer"
    },
    "settings": {
      "items": {
        "$ref": "#/$defs/SettingField"
      },
      "title": "Settings",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "kind"
  ],
  "title": "DisPatch connection manifest",
  "type": "object"
}
