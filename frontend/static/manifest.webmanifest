{
  "id": "/?source=pwa",
  "name": "DisPatch Chat",
  "short_name": "DisPatch",
  "description": "DisPatch Chat — local-first chat for OpenClaw agents",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "any",
  "//": "lang/dir describe THIS FILE's own strings (name, short_name, description), which are English and LTR — not the app, which ships eight locales including Arabic. A manifest is static and cannot vary per user; the running document sets its own lang/dir (see the no-FOUC script in index.html). Do not \"fix\" these to match the user's language.",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "background_color": "#0f0f1a",
  "theme_color": "#0f0f1a",
  "icons": [
    { "src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
