# Copy to stack.env (next to stack.yml) and pass it with --env-file. Every value is optional.
#   docker compose -f deploy/compose/stack.yml --env-file deploy/compose/stack.env up -d

# --- what DisPatch's first connection asks StudioForge for ---------------------
# The model id StudioForge should serve (see its panel's Models tab or
# http://localhost:1234/v1/models). Written once into a fresh data volume.
STACK_MODEL=your-model-id

# --- images --------------------------------------------------------------------
# Unset DISPATCH_IMAGE builds the image from this checkout (no registry needed).
# DISPATCH_IMAGE=ghcr.io/laserlloyd/dispatch:latest
# Pick the backend by the image tag: -cuda | -rocm | -vulkan  (NVIDIA is the only
# one StudioForge can drive today; see its docs).
# STUDIOFORGE_IMAGE=ghcr.io/laserlloyd/studioforge:1.26-09-23-cuda
# INFOFORGE_IMAGE=ghcr.io/laserlloyd/infoforge:2.0.0

# --- network exposure ------------------------------------------------------------
# 127.0.0.1 = this machine only (default). 0.0.0.0 = your LAN: set a DisPatch PIN
# first, and give StudioForge an api_key (its Setup tab).
BIND_ADDR=127.0.0.1
DISPATCH_PORT=8765
STUDIOFORGE_GATEWAY_PORT=1234
STUDIOFORGE_PANEL_PORT=8080

# --- storage ---------------------------------------------------------------------
# Host folder holding your .gguf files (mounted read-only into StudioForge).
STUDIOFORGE_MODELS=./models
TZ=UTC

# --- DisPatch image build args (only when building from source) ------------------
# VERSION=dev
# VOICE=0          # 1 = include the DisPatch Voice add-on (adds ffmpeg + libopus to the image)
# VOICE_REF=refs/heads/refactor/prosumer-2026   # the add-on ref to install: refs/tags/v1.6.0 once released

# --- optional knowledge stack (--profile knowledge) --------------------------------
# ZIM_DIR=./zims
# ZIM_FILE=wikipedia_en_simple_all_nopic.zim     # InfoForge's config
# ZIM_GLOB=*.zim                                 # what kiwix-serve serves
# KIWIX_USER=1001                                # rootless podman: 0
