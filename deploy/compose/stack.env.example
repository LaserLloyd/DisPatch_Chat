# Copy to stack.env (next to stack.yml) and pass it with --env-file. Every value is optional.
#   docker compose -f deploy/compose/stack.yml --env-file deploy/compose/stack.env up -d

# --- what DisPatch's first connection asks StudioForge for ---------------------
# The model id StudioForge should serve (see its panel's Models tab or
# http://localhost:1234/v1/models). Written once into a fresh data volume.
STACK_MODEL=your-model-id

# --- images --------------------------------------------------------------------
# Unset DISPATCH_IMAGE builds the image from this checkout (no registry needed).
# DISPATCH_IMAGE=ghcr.io/laserlloyd/dispatch_chat:latest
# Pick the backend by the image tag: -cuda | -rocm | -vulkan  (NVIDIA is the only
# one StudioForge can drive today; see its docs).
# STUDIOFORGE_IMAGE=ghcr.io/laserlloyd/studioforge:2.0.0-cuda
# The slim -cuda image has no compiler: on a fresh volume its entrypoint downloads upstream's prebuilt
# llama.cpp engine once (about 150 MB, about a minute; SF_ENGINE_BOOTSTRAP=0 skips it for offline hosts).
# You do NOT need the 14 GB -cuda-devel image for NVIDIA; use it only to build an engine from source.
# INFOFORGE_IMAGE=ghcr.io/laserlloyd/infoforge:2.1.0

# --- StudioForge owner account (created on the first start of a fresh volume) ----
# 2.x images refuse to listen beyond loopback with nothing to sign in with, and a
# published port counts. Empty password = one is generated into
# /data/owner-password.initial on the studioforge volume (10+ characters otherwise).
# SF_OWNER_USER=owner
# SF_OWNER_PASSWORD=

# --- network exposure ------------------------------------------------------------
# 127.0.0.1 = this machine only (default). 0.0.0.0 = your LAN: finish DisPatch's setup
# wizard (owner account) first, and give the StudioForge connection an API key
# (StudioForge panel -> Users & Keys; see docs/deploy/stack.md).
BIND_ADDR=127.0.0.1
DISPATCH_PORT=8765
STUDIOFORGE_GATEWAY_PORT=1234
STUDIOFORGE_PANEL_PORT=8080
STUDIOFORGE_WATCHDOG_PORT=1235

# --- storage ---------------------------------------------------------------------
# Host folder holding your .gguf files (mounted read-only into StudioForge).
STUDIOFORGE_MODELS=./models
TZ=UTC

# --- DisPatch image build args (only when building from source) ------------------
# VERSION=dev
# VOICE=0          # 1 = include the DisPatch Voice add-on (adds ffmpeg + libopus to the image)
# VOICE_REF=refs/heads/main   # the add-on ref to install: refs/tags/v1.6.0 once released

# --- optional knowledge stack (--profile knowledge) --------------------------------
# ZIM_DIR=./zims
# ZIM_FILE=wikipedia_en_simple_all_nopic.zim     # InfoForge's config
# ZIM_GLOB=*.zim                                 # what kiwix-serve serves
# KIWIX_USER=1001                                # rootless podman: 0
